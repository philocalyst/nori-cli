// Default runtime policy. Unspecified limits remain unlimited.
name = "nori-default"
// Set to an object such as new Dynamic { agent = "claude"; model = "haiku" }.
commit_reviewer = null

// What a session does when a request to its model fails.
//
// A failure is classified (structured ACP error data first, message text last) into one of:
//   rate_limited, quota_exhausted, model_unavailable, capacity (alias: overloaded),
//   server_error, network, auth, prompt_too_long
// then:
//   1. kind in retry.on and attempts left -> the same route is retried after a backoff
//      (visible in the transcript, cancelled with Esc); the provider's retry-after is honoured.
//   2. kind in fallback.on -> the session moves to the next route: `chain` in order, then (when
//      `ranked`) every other installed route for the same model ranked with native providers
//      first, then other models. The session header always shows the route actually running.
//   3. otherwise the failure is shown with its cause.
// Layers deep-merge: user policy ($NORI_HOME/init.pkl) and project policy (.nori/nori.pkl) only
// need to state what they change. Durations are Pkl durations (`2.s`, `500.ms`, `1.min`);
// a bare number is read as seconds.
recovery = new Dynamic {
  retry = new Dynamic {
    // Retries after the first failure; 0 turns retrying off.
    max_attempts = 4
    // The first retry waits this long, then double, up to max_backoff.
    initial_backoff = 2.s
    max_backoff = 60.s
    // Randomise each wait by plus or minus this fraction, so parallel sessions spread out.
    jitter = 0.2
    on = List("server_error", "capacity", "network", "rate_limited")
  }
  fallback = new Dynamic {
    // Capacity errors are retried above first; falling back happens once those attempts are used.
    on = List("quota_exhausted", "model_unavailable", "capacity")
    // Routes to try in order, e.g. List(new Dynamic { agent = "claude-code"; model = "haiku" }).
    chain = List()
    // After the chain, continue with the ranked catalog of installed agents and models.
    ranked = true
    // Among routes to the same model (two accounts of one provider), prefer the account with the
    // most room left in its rate limit windows, and try one known to be spent last.
    prefer_headroom = true
    // never | after_reset | next_session: when to go back to the route you chose.
    return_to_primary = "next_session"
  }
  // Per-role overrides for delegated subagents (implementation, research, review, design, test,
  // general), e.g. roles = new Mapping { ["review"] = new Dynamic { fallback = new Dynamic {
  //   chain = List(new Dynamic { agent = "claude-code"; model = "haiku" }) } } }
  roles = new Mapping {}
  // Per-agent overrides, e.g. agents = new Mapping { ["codex"] = new Dynamic {
  //   retry = new Dynamic { max_attempts = 2 } } }. A role override beats an agent override.
  agents = new Mapping {}
}

// When a session compacts itself, and how a refused checkpoint is cut down. Layers merge field
// by field; a list is replaced as a whole.
compaction = new Dynamic {
  // Compact before the next prompt once the context nears the window's end. Compaction runs only
  // between turns, never in the middle of one.
  auto = true
  // Compact when the free context is below max(trigger_free_fraction * window, trigger_free_tokens).
  trigger_free_fraction = 0.15
  trigger_free_tokens = 16000
  // Prepare the summary this many tokens of free context before that point, while the provider's
  // prompt cache is warm, so the switch is instant. 0 prepares nothing early. What happens after
  // the summary reaches the new session as the checkpoint's verbatim recent context (15,000
  // tokens), so a margin beyond that mostly prepares summaries that are rewritten.
  background_margin_tokens = 12000
  // When the provider refuses a prompt as too long, retry with the checkpoint of earlier
  // conversation cut to each of these fractions of its size in turn.
  shrink_ladder = List(0.85, 0.7, 0.5, 0.35)
  // Use the agent's own /compact when it advertises one.
  prefer_native = true
}

// What happens when the agent calls the same tool with the same input over and over.
// A signature (tool and a hash of its input) is a loop when it fills more than `repeats` of the
// last `window` tool calls of a turn.
//   nudge_then_stop: steer the agent once, then cancel the turn if it loops again in the same task
//   nudge:           steer once per task and otherwise let it go on
//   stop:            cancel the turn at once, as Esc does
//   off:             do not look for loops
loops = new Dynamic {
  window = 10
  repeats = 5
  action = "nudge_then_stop"
}

// Who checks that a goal is really done. An agent calls `update_goal` with `complete`; with `judge`
// on, Nori first has a fresh reviewer with no tools read the session's transcript (tool outputs
// are the evidence; the agent's say-so is not) and decide: done, not yet (the agent is told what
// is missing and goes on), blocked, or paused. A reviewer that cannot run or does not answer in
// `judge_timeout` never holds anything up: the agent's word is accepted and marked unverified.
// Layers merge field by field; `null` sets an agent or model back to the default.
goals = new Dynamic {
  judge = true
  // The agent the reviewer runs on, e.g. "claude-code". null: this session's own agent.
  judge_agent = null
  // The reviewer's model, e.g. "haiku". null: that agent's default model.
  judge_model = null
  judge_timeout = 120.s
  // After this many "not yet" verdicts in a row for one goal, the next `complete` pauses the goal
  // and the person decides, instead of asking the reviewer again.
  max_disagreements = 3
}
