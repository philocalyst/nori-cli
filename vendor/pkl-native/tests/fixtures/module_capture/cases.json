  {
    "name": "collection-module-identity",
    "files": {
      "test.pkl": "open module birds\nlocal items = List(module)\nx=1\nresult=List(items.first.getClass().toString(), items.first is module, items.first is Map, items.first.getClass()==module.getClass())\n"
    },
    "expected": {
      "x": 1,
      "result": [
        "birds",
        true,
        false,
        true
      ]
    }
  },
  {
    "name": "shadowed-module-map",
    "files": {
      "test.pkl": "open module birds\nresult=let(`module`=Map(\"x\",2)) List(`module`).first.getClass()==Map\n"
    },
    "expected": {
      "result": true
    }
  },
  {
    "name": "nested-object-this-is-not-module",
    "files": {
      "test.pkl": "open module birds\nresult=let(obj=new Dynamic {x=2; y=List(this).first.x}) List(obj.x,obj.y,obj is Dynamic)\n"
    },
    "expected": {
      "result": [
        2,
        2,
        true
      ]
    }
  },
  {
